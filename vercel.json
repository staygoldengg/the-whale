{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "regions": ["iad1"],
  "env": {
    "NEXT_PUBLIC_SUPABASE_URL": { "description": "Supabase project URL" },
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": { "description": "Supabase anon key" },
    "SUPABASE_SERVICE_ROLE_KEY": { "description": "Supabase service role key" },
    "OPENAI_API_KEY": { "description": "OpenAI API key (optional)" },
    "OPENAI_MODEL": { "description": "OpenAI model name" }
  },
  "functions": {
    "app/api/ai/generate/route.ts": { "maxDuration": 30 },
    "app/api/google/workspace/route.ts": { "maxDuration": 30 },
    "app/api/validate/preflight/route.ts": { "maxDuration": 15 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=3600" }
      ]
    }
  ],
  "buildCache": {
    "nodejs": true,
    "paths": ["node_modules/**", ".next/cache/**"]
  }
}
